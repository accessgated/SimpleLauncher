<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>SimpleLauncher</RootNamespace>
    <AssemblyName>SimpleLauncher</AssemblyName>
    <ApplicationIcon>..\..\Assets\SimpleLaucher.ico</ApplicationIcon>
    <Version>0.1.3</Version>
    <Authors>SimpleLauncher contributors</Authors>
    <Description>A standalone fullscreen Windows launcher for kiosk, family, school, and public-computer scenarios.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\..\Assets\Background.jpg" Link="Assets\Background.jpg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Assets\SimpleLaucher.ico" Link="Assets\SimpleLauncher.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
