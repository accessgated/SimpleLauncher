<Window x:Class="SimpleLauncher.Presentation.Windows.RecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SimpleLauncher Recovery"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True"
        Background="#0B1220"
        FontFamily="Segoe UI">
    <Grid Margin="48">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
            <TextBlock x:Name="TitleText" Text="SimpleLauncher Recovery" FontSize="32" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,24" />
            <Button x:Name="ReturnButton" Content="Return to Launcher" Height="48" Margin="0,0,0,16" Click="OnReturnToLauncher" />
            <Button x:Name="DesktopButton" Content="Open Windows Desktop" Height="48" Click="OnOpenDesktop" />
        </StackPanel>
    </Grid>
</Window>