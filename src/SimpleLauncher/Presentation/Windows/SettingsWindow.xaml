<Window x:Class="SimpleLauncher.Presentation.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="760"
        Height="650"
        MinWidth="680"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource LauncherSurfaceBrush}">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Padding="12" CornerRadius="12" Background="{DynamicResource LauncherBackgroundBrush}">
            <DockPanel>
                <TextBlock x:Name="ApplicationsHeader" Text="Applications" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource LauncherTextBrush}" DockPanel.Dock="Top" Margin="0,0,0,12" />
                <ListBox x:Name="AppsList" DisplayMemberPath="DisplayName" SelectionChanged="OnSelectionChanged" />
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Margin="18,0,0,0" Padding="16" CornerRadius="12" Background="{DynamicResource LauncherBackgroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="SelectedApplicationHeader" Text="Selected application" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource LauncherTextBrush}" />
                    <TextBox x:Name="NameBox" Height="34" Margin="0,12,0,8" VerticalContentAlignment="Center" />
                    <TextBox x:Name="CategoryBox" Height="34" Margin="0,0,0,8" VerticalContentAlignment="Center" />
                    <CheckBox x:Name="FavoriteBox" Content="Favorite" Foreground="{DynamicResource LauncherTextBrush}" Margin="0,4,0,0" />
                    <CheckBox x:Name="RequiresPinBox" Content="Require PIN" Foreground="{DynamicResource LauncherTextBrush}" Margin="0,8,0,18" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ApplyButton" Content="Apply" Width="88" Margin="0,0,8,0" Click="OnApplyApplication" />
                        <Button x:Name="RemoveButton" Content="Remove" Width="88" Click="OnRemoveApplication" />
                    </StackPanel>

                    <Separator Margin="0,24,0,18" />

                    <TextBlock x:Name="LauncherHeader" Text="Launcher" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource LauncherTextBrush}" />
                    <TextBlock x:Name="BackgroundLabel" Text="Background image" Foreground="{DynamicResource LauncherMutedTextBrush}" Margin="0,12,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="BackgroundPathBox" Width="320" Height="34" VerticalContentAlignment="Center" />
                        <Button x:Name="ChooseBackgroundButton" Content="Choose image" Width="110" Margin="8,0,0,0" Click="OnChooseBackground" />
                    </StackPanel>
                    <TextBlock x:Name="LanguageLabel" Text="Language" Foreground="{DynamicResource LauncherMutedTextBrush}" Margin="0,8,0,4" />
                    <TextBox x:Name="LanguageBox" Width="220" Height="34" VerticalContentAlignment="Center" />
                    <TextBlock x:Name="DeepLKeyLabel" Text="DeepL API key" Foreground="{DynamicResource LauncherMutedTextBrush}" Margin="0,8,0,4" />
                    <TextBox x:Name="DeepLApiKeyBox" Width="320" Height="34" VerticalContentAlignment="Center" />
                    <CheckBox x:Name="EnableDeepLBox" Content="Enable DeepL translation" Foreground="{DynamicResource LauncherTextBrush}" Margin="0,10,0,8" />
                    <TextBlock x:Name="IconSizeLabel" Text="Icon size" Foreground="{DynamicResource LauncherMutedTextBrush}" Margin="0,8,0,4" />
                    <Slider x:Name="IconSizeSlider" Minimum="48" Maximum="192" TickFrequency="8" IsSnapToTickEnabled="True" />
                    <CheckBox x:Name="LockSettingsBox" Content="Protect settings with PIN" Foreground="{DynamicResource LauncherTextBrush}" Margin="0,12,0,0" />
                    <CheckBox x:Name="HideTaskbarBox" Content="Hide taskbar in fullscreen mode" Foreground="{DynamicResource LauncherTextBrush}" Margin="0,8,0,0" />

                    <Separator Margin="0,24,0,18" />

                    <TextBlock x:Name="ChangePinHeader" Text="Change Administrator PIN" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource LauncherTextBrush}" />
                    <TextBlock x:Name="CurrentPinLabel" Text="Current PIN" Foreground="{DynamicResource LauncherMutedTextBrush}" Margin="0,12,0,4" />
                    <PasswordBox x:Name="CurrentPinBox" Height="34" />
                    <TextBlock x:Name="NewPinLabel" Text="New PIN" Foreground="{DynamicResource LauncherMutedTextBrush}" Margin="0,10,0,4" />
                    <PasswordBox x:Name="NewPinBox" Height="34" />
                    <TextBlock x:Name="ConfirmPinLabel" Text="Confirm new PIN" Foreground="{DynamicResource LauncherMutedTextBrush}" Margin="0,10,0,4" />
                    <PasswordBox x:Name="ConfirmPinBox" Height="34" />
                    <Button x:Name="ChangePinButton" Content="Change PIN" Width="108" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnChangePin" />
                    <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                        <Button x:Name="BackupButton" Content="Backup" Width="88" Margin="0,0,8,0" Click="OnBackup" />
                        <Button x:Name="ImportButton" Content="Import" Width="88" Margin="0,0,8,0" Click="OnImport" />
                        <Button x:Name="ExportButton" Content="Export" Width="88" Click="OnExport" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Width="88" Margin="0,0,8,0" IsCancel="True" />
            <Button x:Name="SaveButton" Content="Save" Width="88" IsDefault="True" Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
