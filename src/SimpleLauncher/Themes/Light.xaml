<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="LauncherBackgroundBrush" Color="#101418" />
    <SolidColorBrush x:Key="LauncherSurfaceBrush" Color="#1B2229" />
    <SolidColorBrush x:Key="LauncherTextBrush" Color="#F7FAFC" />
    <SolidColorBrush x:Key="LauncherMutedTextBrush" Color="#AAB4BF" />
    <Style TargetType="Button">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Background" Value="#26323D" />
        <Setter Property="Foreground" Value="#F7FAFC" />
        <Setter Property="BorderBrush" Value="#405160" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="LauncherTileButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Margin" Value="0,0,18,18" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Background" Value="#202A33" />
        <Setter Property="BorderBrush" Value="#334553" />
    </Style>
</ResourceDictionary>
